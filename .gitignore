# Repo-root ignores. Added 2026-08-09 when 17 tracked .pyc files were untracked.
# Convention follows "Phase A/.gitignore".
#
# DELIBERATELY NARROW. This repository is PUBLIC and the paper's data-availability
# statement promises the environment, models, evaluation scripts and raw per-condition
# result logs. Do NOT add models/, results*/, or *.txt log patterns here -- those are
# the artifact. Only build junk belongs below.

# Python bytecode -- compiled output, platform- and version-specific, never source.
__pycache__/
*.py[cod]
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Scratch / not part of the public artifact.
# NOTE: git has NO trailing-comment support in .gitignore -- a '#' only starts a
# comment at the START of a line. Keep every comment on its own line or the
# pattern silently becomes literal text and matches nothing.

# Task Manager screenshot; Srinivasa's standing decision: never commit
Phase_CD/temp.png

# the publisher's own RAS author guide (5.2 MB), not our work
Phase_CD/Papers/

# stray 0-byte file
claude
